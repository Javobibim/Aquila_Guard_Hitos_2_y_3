{
  "info": {
    "name": "Aquila Guard Hito 2 - CRUD y reintentos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3000/api/v1"
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "analisis_id",
      "value": ""
    },
    {
      "key": "alertas_id",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "POST /analisis -> 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "url": "{{base_url}}/analisis",
        "body": {
          "mode": "raw",
          "raw": "{\"tipo\": \"correo\", \"contenido\": \"From: PayPal <notificaciones@documentos-cuenta.example>\\nReply-To: ayuda@revision-pagos.example\\nTo: usuario@destinatario.example\\nSubject: Documento de cuenta disponible\\nAuthentication-Results: receptor.example; spf=fail smtp.mailfrom=documentos-cuenta.example; dkim=fail; dmarc=fail\\nMIME-Version: 1.0\\nContent-Type: text/html; charset=UTF-8\\n\\n<html><body><p>Hola, hay un documento disponible en tu cuenta.</p><a href=\\\"https://bancoestado.cl.acceso.example/consulta\\\">https://www.paypal.com/mi-cuenta</a><p>Ejemplo ficticio para una prueba de señales. No abrir el destino.</p></body></html>\\n\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"idempotency_key\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set('analisis_id',pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /analisis con la misma clave -> 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "url": "{{base_url}}/analisis",
        "body": {
          "mode": "raw",
          "raw": "{\"tipo\": \"correo\", \"contenido\": \"From: PayPal <notificaciones@documentos-cuenta.example>\\nReply-To: ayuda@revision-pagos.example\\nTo: usuario@destinatario.example\\nSubject: Documento de cuenta disponible\\nAuthentication-Results: receptor.example; spf=fail smtp.mailfrom=documentos-cuenta.example; dkim=fail; dmarc=fail\\nMIME-Version: 1.0\\nContent-Type: text/html; charset=UTF-8\\n\\n<html><body><p>Hola, hay un documento disponible en tu cuenta.</p><a href=\\\"https://bancoestado.cl.acceso.example/consulta\\\">https://www.paypal.com/mi-cuenta</a><p>Ejemplo ficticio para una prueba de señales. No abrir el destino.</p></body></html>\\n\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Recupera el mismo análisis sin exponer el texto original\", () => {",
              "  pm.response.to.have.status(200);",
              "  const result = pm.response.json().data;",
              "  pm.expect(result.id).to.eql(pm.collectionVariables.get(\"analisis_id\"));",
              "  pm.expect(result).not.to.have.property(\"contenido\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /analisis/{{analisis_id}} -> 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/analisis/{{analisis_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH /analisis/{{analisis_id}} -> 200",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/analisis/{{analisis_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"nota\": \"Revisado con datos ficticios\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /alertas -> 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/alertas",
        "body": {
          "mode": "raw",
          "raw": "{\"analisis_id\": \"{{analisis_id}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set('alertas_id',pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /alertas/{{alertas_id}} -> 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/alertas/{{alertas_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH /alertas/{{alertas_id}} -> 200",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/alertas/{{alertas_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"revisada\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /alertas -> 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/alertas",
        "body": {
          "mode": "raw",
          "raw": "{\"analisis_id\": \"{{analisis_id}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE /alertas/{{alertas_id}} -> 204",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/alertas/{{alertas_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE /analisis/{{analisis_id}} -> 204",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/analisis/{{analisis_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /analisis/{{analisis_id}} -> 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/analisis/{{analisis_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
