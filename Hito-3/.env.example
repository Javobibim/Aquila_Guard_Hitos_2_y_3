# Copiar esta plantilla dentro de backend-hito2/.env si se configura a mano.
# Demostración local. Cambiar API_KEY por una clave propia. Nunca subir .env.
HOST=127.0.0.1
PORT=3000
API_KEY=
# Opción local gratuita por defecto. postgres requiere DATABASE_URL y un servidor propio.
DB_DRIVER=pglite
DATABASE_URL=postgresql://aquila:CAMBIAR_PASSWORD@127.0.0.1:5432/aquila_guard
PGLITE_PATH=.data/aquila

# Solo para docker compose. Debe coincidir con DATABASE_URL.
POSTGRES_PASSWORD=
